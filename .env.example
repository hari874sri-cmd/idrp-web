# ==========================================
# ReRoute AI Environment Configuration
# ==========================================

# Django Configuration
DJANGO_SECRET_KEY=reroute-ai-production-super-secret-key-change-in-prod-xyz789
DJANGO_DEBUG=True

# Database Configuration
# Default: sqlite (zero configuration required for local dev)
# Set to 'postgresql' for PostgreSQL production database
DB_ENGINE=sqlite
# POSTGRES_DB=reroute_ai
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Or standard DATABASE_URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/reroute_ai

# AI Provider Configuration
# Options: 'demo' (deterministic offline demo mode), 'gemini', 'openai'
AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Environment Variables
VITE_API_BASE_URL=/api/v1

